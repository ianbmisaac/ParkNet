rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ROL ADMINISTRADOR: existe un documento admins/{uid} con admin == true.
    // Se crea A MANO desde la consola de Firebase (las reglas no permiten
    // auto-asignarse el rol). Ver docs/GUIA_ADMIN.md.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    function validSpace(spaceId) {
      return spaceId in ['A1', 'A2', 'A3'];
    }

    function validDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validHour(hour) {
      return hour is string && hour.matches('^(0[0-9]|1[0-9]|2[0-3])$');
    }

    match /slots/{slotId} {
      // These documents contain only the space and time block, never user details.
      allow get, list: if signedIn();

      // A slot lock and the owner's private reservation must be written atomically.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['spaceId', 'date', 'hour', 'bookingId'])
        && request.resource.data.keys().hasAll(['spaceId', 'date', 'hour', 'bookingId'])
        && validSpace(request.resource.data.spaceId)
        && validDate(request.resource.data.date)
        && validHour(request.resource.data.hour)
        && request.resource.data.bookingId is string
        && slotId == request.resource.data.spaceId + '_' + request.resource.data.date + '_' + request.resource.data.hour
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/reservations/$(request.resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/reservations/$(request.resource.data.bookingId)).data.slotKey == slotId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/reservations/$(request.resource.data.bookingId)).data.status == 'active';

      allow delete: if (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/reservations/$(resource.data.bookingId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/reservations/$(resource.data.bookingId)).data.slotKey == slotId)
        || isAdmin();
      allow update: if false;
    }

    // Registro de administradores: se escribe SOLO desde la consola
    // (el papel permite borrarlo accidentalmente).
    match /admins/{adminUid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Perfil del usuario: foto de perfil (miniatura comprimida por la pagina).
    // Solo su dueno puede escribir, y solo esos dos campos.
    match /users/{userId}/profile/{docId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['avatar', 'updatedAt'])
        && request.resource.data.keys().hasAll(['avatar', 'updatedAt'])
        && request.resource.data.avatar is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth.uid == userId;
    }

    match /users/{userId}/reservations/{bookingId} {
      allow get, list: if (signedIn() && request.auth.uid == userId) || isAdmin();

      // The matching slot lock must be created in the same Firestore transaction.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'bookingId', 'slotKey', 'spaceId', 'date', 'hour',
          'userId', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'bookingId', 'slotKey', 'spaceId', 'date', 'hour',
          'userId', 'status', 'createdAt'
        ])
        && request.resource.data.bookingId == bookingId
        && request.resource.data.userId == userId
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && validSpace(request.resource.data.spaceId)
        && validDate(request.resource.data.date)
        && validHour(request.resource.data.hour)
        && request.resource.data.slotKey == request.resource.data.spaceId + '_' + request.resource.data.date + '_' + request.resource.data.hour
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotKey)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotKey)).data.spaceId == request.resource.data.spaceId;

      // Cancellation frees the slot and marks the owner's record cancelled atomically.
      allow update: if (signedIn()
        && request.auth.uid == userId
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && !existsAfter(/databases/$(database)/documents/slots/$(resource.data.slotKey)))
        || (isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']));
      // NOTA admin: la actualizacion del admin no exige !existsAfter del
      // slot, porque el admin cancela primero la reserva y libera el
      // bloqueo en la misma transaccion del cliente (ver admin.html).
      // El borrado del bloqueo lo autoriza isAdmin() en /slots.

      allow delete: if false;
    }
  }
}
